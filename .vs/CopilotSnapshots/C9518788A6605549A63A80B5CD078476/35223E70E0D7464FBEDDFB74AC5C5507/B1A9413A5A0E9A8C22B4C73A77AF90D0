using System.Text.RegularExpressions;
using System;
using System.Collections.Generic;
using System.Text.RegularExpressions;
namespace review2;

public class FilterChain<T>
{
    private List<Func<T, bool>> _filters = new();
    private Queue<Func<T, bool>> _executionOrder = new();
    private Stack<Func<T, bool>> _historyOfFilters = new();

    // private Func<List<T>, List<T>> FindCreditTrasactions = f => f.FindAll(item => Regex.IsMatch(item, "credited"));
    public Func<List<string>, List<string>> FindCreditTransactions = list => list.FindAll(item => Regex.IsMatch(item, "credited", RegexOptions.IgnoreCase));

    
    public bool ApplyFilter(Func<T, bool> filter)
    {
        try
        {
            _historyOfFilters.Push(filter);
            _executionOrder.Enqueue(filter);
            _filters.Add(filter);
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"{ex.Message}");
        }

        return false;
    }

    public void Undo()
    {
        T removedFilter = _historyOfFilters.Pop();
        Console.WriteLine($"Applied filter {removedFilter} has been removed");
    }

    public Stack<T> HistoryOfFilters
    {
        get => _historyOfFilters;
        // set => _historyOfFilters = value ?? throw new ArgumentNullException(nameof(value));
    }
}