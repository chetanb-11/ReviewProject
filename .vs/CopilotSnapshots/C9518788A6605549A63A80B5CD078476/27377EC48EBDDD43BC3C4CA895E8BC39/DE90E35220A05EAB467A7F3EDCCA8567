using System.Text.RegularExpressions;
using System;
using System.Collections.Generic;
using System.Text.RegularExpressions;
namespace review2;

public class FilterChain<T>
{
    private Dictionary<string, Func<T, T>> _filters = new();
    private Queue<Func<T, T>> _executionOrder = new();
    private Stack<Func<T, T>> _historyOfFilters = new();

    // private Func<List<T>, List<T>> FindCreditTrasactions = f => f.FindAll(item => Regex.IsMatch(item, "credited"));
    public Func<List<string>, List<string>> FindCreditTransactions = list => list.FindAll(item => Regex.IsMatch(item, "credited", RegexOptions.IgnoreCase));

    
    public bool ApplyFilter(Func<T, T> filter)
    {
        try
        {
            _historyOfFilters.Push(filter);
            _executionOrder.Enqueue(filter);
            _filters.Add(filter);
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"{ex.Message}");
        }

        return false;
    }

    public void Undo()
    {
        var removedFilter = _historyOfFilters.Pop();

        _filters.Remove(removedFilter);

        Console.WriteLine($"Applied filter {removedFilter} has been removed");
    }

    public Stack<Func<T, bool>> HistoryOfFilters
    {
        get => _historyOfFilters;
    }
}