using System.Text.RegularExpressions;
using System;
using System.Collections.Generic;
using System.Text.RegularExpressions;
namespace review2;

public class FilterChain<T>
{
    private Dictionary<string, Func<T, T>> _filters = new();
    private Queue<Dictionary<string, Func<T, T>>> _executionOrder = new();
    private Stack<Dictionary<string, Func<T, T>>> _historyOfFilters = new();

    public List<string> FindCreditTransactions(IEnumerable<string>? list)
    {
        if (list is null) return new List<string>();

        return list
            .Where(item => !string.IsNullOrEmpty(item) && Regex.IsMatch(item!, "credited", RegexOptions.IgnoreCase))
            .ToList();
    }
    
    
    
    public bool ApplyFilter(Func<T, T> filter)
    {
        try
        {
            _historyOfFilters.Push(filter);
            _executionOrder.Enqueue(filter);
            _filters.Add("filtername", filter);
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"{ex.Message}");
        }

        return false;
    }

    public void Undo()
    {
        var removedFilter = _historyOfFilters.Pop();

        // _filters.Remove(removedFilter);

        Console.WriteLine($"Applied filter {removedFilter} has been removed");
    }

    public Stack<Dictionary<string, Func<T, T>>> HistoryOfFilters
    {
        get => _historyOfFilters;
    }
}